<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="Armor Values">
    <BoxContainer Orientation="Vertical" SeparationOverride="4" MinWidth="50" Margin="4">
        <Label Text="{Loc ssmc-admin-enter-bullet-armor}" />
        <LineEdit Name="BulletLineEdit" Text="{Loc ssmc-admin-enter-bullet-armor}" />
        <Label Text="{Loc ssmc-admin-enter-melee-armor}" />
        <LineEdit Name="MeleeLineEdit" Text="{Loc ssmc-admin-enter-melee-armor}" />
        <Label Text="{Loc ssmc-admin-enter-explosion-armor}" />
        <LineEdit Name="ExplosionLineEdit" Text="{Loc ssmc-admin-enter-explosion-armor}" />
        <Label Text="{Loc ssmc-admin-bio-armor}" />
        <LineEdit Name="BioLineEdit" Text="{Loc ssmc-admin-enter-bio-armor}" />
    </BoxContainer>
</DefaultWindow>
