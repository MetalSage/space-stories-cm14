<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               Title="{Loc 'ui-lobby-join-game-title'}"
               MinSize="300 200"
               Resizable="False">
    <BoxContainer Orientation="Vertical" SeparationOverride="10" Margin="10">
        <Button Name="JoinMarineButton"
                Access="Public"
                Text="{Loc 'ui-lobby-join-marine'}"
                StyleClasses="ButtonBig"
                MinHeight="50"/>
        <Button Name="JoinXenoButton"
                Access="Public"
                Text="{Loc 'ui-lobby-join-xeno'}"
                StyleClasses="ButtonBig"
                MinHeight="50"/>
        <Button Name="JoinHunterButton"
                Access="Public"
                Text="{Loc 'ui-lobby-join-hunter'}"
                StyleClasses="ButtonBig"
                MinHeight="50"
                Visible="False"/>
        <Label Name="HunterRequirementLabel"
               Access="Public"
               Text="{Loc 'ui-lobby-join-hunter-req'}"
               HorizontalAlignment="Center"
               Visible="False"
               FontColorOverride="Gray"/>
    </BoxContainer>
</DefaultWindow>
