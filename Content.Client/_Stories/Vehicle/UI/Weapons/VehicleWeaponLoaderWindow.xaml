<controls:FancyWindow xmlns="https://spacestation14.io"
                     xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                     SetSize="450 350"
                     MinSize="350 250"
                     Resizable="True"
                     Title="Weapon Loader - Select Weapon to Reload">
    <BoxContainer Orientation="Vertical" VerticalExpand="True" Margin="8">
        <Label Text="Available Weapons:" Margin="0,0,0,8" />
        <Label Text="[✓] = Loaded Magazine | [✗] = Empty" 
               Margin="0,0,0,4" 
               StyleClasses="LabelSubText"/>
        <Label Text="(Spare/Max) shows backup magazine count" 
               Margin="0,0,0,8" 
               StyleClasses="LabelSubText"/>
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="HardpointsContainer" 
                         Orientation="Vertical" 
                         VerticalExpand="True" 
                         Access="Public" />
        </ScrollContainer>
        <Label Text="Click weapon to reload from spare magazines" 
               Margin="0,8,0,0" 
               StyleClasses="LabelSubText"/>
    </BoxContainer>
</controls:FancyWindow>