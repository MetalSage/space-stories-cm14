<controls:FancyWindow xmlns="https://spacestation14.io"
                     xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                     xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                     SetSize="750 550"
                     MinSize="600 400"
                     Resizable="False"
                     Title="Hardpoints">
    <BoxContainer Orientation="Vertical" VerticalExpand="True" Margin="6" Access="Public">
        <BoxContainer Orientation="Horizontal" VerticalExpand="True" HorizontalExpand="True" StyleClasses="PanelShadow" MinHeight="450" Access="Public">
            <PanelContainer VerticalExpand="True" HorizontalExpand="True" MinWidth="300" Margin="0,0,6,0" Access="Public">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#1E1E24" BorderColor="#4A4A55" BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" VerticalExpand="True" Margin="3" Access="Public">
                    <Label Text="Available Hardpoints" FontColorOverride="#E6E6E6" StyleClasses="HeadingLabel" Margin="2,2,2,4" Access="Public" />
                    <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False" StyleClasses="TransparentScroll" Access="Public">
                        <BoxContainer Name="HardpointsContainer" Orientation="Vertical" VerticalExpand="True" Margin="1" Access="Public" />
                    </ScrollContainer>
                </BoxContainer>
            </PanelContainer>
            <PanelContainer VerticalExpand="True" MinWidth="300" Access="Public">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#1E1E24" BorderColor="#4A4A55" BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" VerticalExpand="True" Margin="3" Access="Public">
                    <Label Text="Hardpoint Preview" HorizontalAlignment="Center" FontColorOverride="#E6E6E6" StyleClasses="HeadingLabel" Margin="0,2,0,4" Access="Public" />
                    <PanelContainer HorizontalAlignment="Center" VerticalAlignment="Center" SetSize="290 290" Margin="0,0,0,4" Access="Public">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BackgroundColor="#0F0F12" BorderColor="#3E3E44" BorderThickness="1" />
                        </PanelContainer.PanelOverride>
                        <SpriteView Name="Mob" Scale="3 3" HorizontalAlignment="Center" VerticalAlignment="Center" SetSize="290 290" Access="Public" />
                    </PanelContainer>
                    <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Name="RotateLeft" Text="&lt;" SetSize="40 20" Access="Public" />
                        <Control MinSize="10 0" />
                        <Button Name="RotateRight" Text="&gt;" SetSize="40 20" Access="Public" />
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
        <PanelContainer HorizontalExpand="True" Margin="0,6,0,0" Access="Public">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="#25252B" BorderColor="#4A4A55" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <Button Name="Select" Text="Select" HorizontalExpand="True" Margin="6" StyleClasses="ButtonColorRed" Disabled="True" Access="Public" />
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>