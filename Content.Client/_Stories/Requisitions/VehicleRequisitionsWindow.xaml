<controls:VehicleRequisitionsWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._Stories.Requisitions"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    Title="Automated Storage and Retrieval System"
    MinSize="500 600">
    <BoxContainer Orientation="Vertical">
        <RichTextLabel Name="PlatformLabel" Access="Public" />
        <Button Name="LowerPlatformButton" Access="Public" Text="Lower platform" StyleClasses="ButtonSquare" Visible="False" />
        <cc:HSeparator Color="#4972A1" Margin="0 5" />
        <ScrollContainer VerticalExpand="True">
            <BoxContainer Name="ItemsContainer" Access="Public" Orientation="Vertical" />
        </ScrollContainer>
    </BoxContainer>
</controls:VehicleRequisitionsWindow>